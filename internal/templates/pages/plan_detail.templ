package pages

import (
    "fmt"
    "github.com/KenShabby/run_plan_generator/internal/db"
    "github.com/KenShabby/run_plan_generator/internal/models"
    "github.com/KenShabby/run_plan_generator/internal/templates/layouts"
)

templ PlanDetailContent(plan db.TrainingPlan, runs []db.RunDay) {
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h1>{ plan.Name }</h1>
        <a href="/plans" role="button" class="secondary"
           hx-get="/plans"
           hx-target="main"
           hx-push-url="true">
            ← Back
        </a>
    </div>
    <p><small>{ plan.PlanType } · { plan.DistanceUnit }
        if plan.StartDate.Valid && plan.EndDate.Valid {
            · { plan.StartDate.Time.Format("Jan 2") } – { plan.EndDate.Time.Format("Jan 2, 2006") }
        }
    </small></p>
    if plan.Description.Valid {
        <p>{ plan.Description.String }</p>
    }

    <style>
        .week-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 4px;
            margin-bottom: 4px;
        }
        .week-container.week-current {
            border-left: 4px solid var(--pico-primary);
            background-color: var(--pico-primary-background);
            padding-left: 8px;
            border-radius: 4px;
        }
        .day-header {
            text-align: center;
            font-size: 0.95rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--pico-color);
            padding: 4px 0;
        }
        .week-label {
            font-size: 0.75rem;
            color: var(--pico--color);
            padding: 6px 0 2px;
        }
        .day-cell {
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-height: 80px;
            background: var(--pico-card-background-color);
            border: 1px solid var(--pico-card-border-color);
            border-radius: 4px;
            padding: 4px;
            font-size: 0.7rem;
        }
        .day-cell.empty {
            background: transparent;
            border: none;
        }
        .run-chip {
            display: flex;
            flex-direction: column;
            gap: 2px;
            height: 100%;
        }
        .run-chip .run-type {
            font-weight: 600;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            color: var(--pico-primary);
        }
        .run-chip .run-dist {
            font-size: 0.75rem;
        }
        .run-chip .run-date {
            font-size: 0.6rem;
            color: var(--pico-muted-color);
        }
        .run-chip .chip-actions {
            display: flex;
            gap: 4px;
            margin-top: auto;
            padding-top: 4px;
        }
        .chip-actions a,
        .chip-actions button {
            font-size: 0.6rem;
            padding: 1px 6px;
            margin: 0;
            border-radius: 3px;
        }
        .add-run-bar {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 8px;
        }
        .add-run-bar button {
            font-size: 0.8rem;
            padding: 4px 12px;
        }
    </style>

    <div class="add-run-bar">
        <a href={ templ.SafeURL(fmt.Sprintf("/plans/%d/export.ics", plan.ID)) }
           role="button"
           class="secondary"
           style="font-size: 1.0rem; padding: 1em 1em;">
            Export to Calendar (.ics file)
        </a>
        <a href={ templ.SafeURL(fmt.Sprintf("/plans/%d/runs/new", plan.ID)) }
           role="button"
           style="font-size: 1.0rem; padding: 1em 1em;">
            + Add Run
        </a>
    </div>

    <!-- Day of week headers -->
    <div class="week-grid">
        <div class="day-header">Mon</div>
        <div class="day-header">Tue</div>
        <div class="day-header">Wed</div>
        <div class="day-header">Thu</div>
        <div class="day-header">Fri</div>
        <div class="day-header">Sat</div>
        <div class="day-header">Sun</div>
    </div>

    <div id="runs-list">
        @RunCalendar(runs, CurrentWeekNumber(plan.StartDate.Time))
    </div>
}

templ RunCalendar(runs []db.RunDay, currentWeekNum int) {
    for _, week := range GroupRunsByWeek(runs) {
        <div
            id={ fmt.Sprintf("week-%d", week.WeekNum) }
            class={ "week-container", templ.KV("week-current", week.WeekNum == currentWeekNum) }
        >
            <div class="week-label">Week { fmt.Sprintf("%d", week.WeekNum) }</div>
            <div class="week-grid">
                for _, dayRuns := range week.Days {
                    if len(dayRuns) > 0 {
                        <div class="day-cell">
                            for _, run := range dayRuns {
                                @CompactRunCard(*run)
                            }
                        </div>
                    } else {
                        <div class="day-cell empty"></div>
                    }
                }
            </div>
        </div>
    }
    <script>
        (() => {
            const current = document.querySelector('.week-current');
            if (current) {
                current.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        })();
    </script>
}
templ CompactRunCard(run db.RunDay) {
    <div class="run-entry" id={ fmt.Sprintf("run-%d", run.ID) } style="display: flex; flex-direction: column; gap: 4px;">
        <div class="run-chip">
            <span class="run-date">{ run.Date.Time.Format("Jan 2") }</span>
            <a class="run-type"
              href={ templ.SafeURL(fmt.Sprintf("/runs/%d?from_plan=%d", run.ID, run.PlanID)) }
              hx-get={ fmt.Sprintf("/runs/%d?from_plan=%d", run.ID, run.PlanID) }
              hx-target="main"
              hx-push-url="true">
              { formatRunType(run.RunType) }
            </a>
            if run.TotalDistance.Valid {
                <span class="run-dist">{ models.FormatDistance(run.TotalDistance.Float64, run.DistanceUnit) }</span>
            }
            if run.Notes.Valid {
                <span class="run-date">{ run.Notes.String }</span>
            }
            <div class="chip-actions">
            if !run.Completed {
                <a class="secondary outline"
                   href={ templ.SafeURL(fmt.Sprintf("/runs/%d/log", run.ID)) }
                   hx-get={ fmt.Sprintf("/runs/%d/log", run.ID) }
                   hx-target="main"
                   hx-push-url="true">
                    ✓
                </a>
            } else {
                <span style="color: var(--pico-primary);">✓</span>
            }
                <button class="secondary outline"
                    hx-delete={ fmt.Sprintf("/runs/%d", run.ID) }
                    hx-target={ fmt.Sprintf("#run-%d", run.ID) }
                    hx-swap="outerHTML"
                    hx-confirm="Delete this run?">
                    ✕
                </button>
            </div>
        </div>
    </div>
}

templ PlanDetail(plan db.TrainingPlan, runs []db.RunDay, username string) {
    @layouts.Base(plan.Name, username) {
        @PlanDetailContent(plan, runs)
    }
}
